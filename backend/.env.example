PORT=4000
DATABASE_URL="postgresql://moneywarden:moneywarden@localhost:5433/moneywarden?schema=public"

# Секрет для подписи access JWT (openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me
# Публичный адрес бэкенда — из него строится OAuth redirect URI
BACKEND_PUBLIC_URL=http://localhost:4000
# Куда редиректить после OAuth-входа
FRONTEND_URL=http://localhost:3000

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# VK ID: https://id.vk.ru/about/business/go → приложение → ID приложения
# Доверенный redirect URL: http://localhost:4000/api/auth/vk/callback
VK_CLIENT_ID=
