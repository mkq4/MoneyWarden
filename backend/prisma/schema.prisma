generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  /// Логин для входа по паролю (хранится в нижнем регистре).
  /// null — пользователь пришёл только через OAuth
  username      String?        @unique
  /// null — OAuth-провайдер (например, VK) не отдал email
  email         String?        @unique
  name          String?
  /// null — пользователь зарегистрирован только через OAuth
  passwordHash  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  passkeys      Passkey[]
  refreshTokens RefreshToken[]
  categories    Category[]
  transactions  Transaction[]
  reminders     PurchaseReminder[]
}

enum AuthProvider {
  GOOGLE
  VK
}

/// Привязка внешнего OAuth-аккаунта к пользователю
model Account {
  id                Int          @id @default(autoincrement())
  provider          AuthProvider
  providerAccountId String
  userId            Int
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Passkey (WebAuthn): вход по Face ID / Touch ID / отпечатку.
/// Хранится только публичный ключ — закрытый не покидает устройство.
model Passkey {
  /// base64url id ключа от аутентификатора
  id         String    @id
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// COSE-ключ
  publicKey  Bytes
  /// Счётчик подписей — защита от клонированных ключей (у Apple всегда 0)
  counter    BigInt    @default(0)
  /// usb | nfc | ble | internal | hybrid — подсказка браузеру при входе
  transports String[]
  /// Название для списка в настройках, например «iPhone»
  name       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/// Refresh-токены хранятся только в виде sha256-хеша
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Категории бывают только INCOME/EXPENSE — проверяется в DTO категорий.
enum TransactionType {
  INCOME
  EXPENSE
  /// Отложено из текущего дохода, amount > 0
  SAVING
  /// Корректировка баланса накоплений (стартовый баланс, проценты, снятие), amount != 0.
  /// Создаётся только через PUT /savings/balance.
  SAVING_ADJUSTMENT
}

model Category {
  id           Int             @id @default(autoincrement())
  userId       Int
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         TransactionType
  /// "#RRGGBB"
  color        String?
  /// Ключ иконки для фронта
  icon         String?
  /// Мягкое удаление: категория скрыта из выбора, но остаётся в истории
  archivedAt   DateTime?
  createdAt    DateTime        @default(now())
  transactions Transaction[]

  @@index([userId, type])
}

model Transaction {
  id         Int             @id @default(autoincrement())
  userId     Int
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       TransactionType
  /// Сумма в копейках; > 0 для всех типов, кроме SAVING_ADJUSTMENT (там != 0).
  /// Инварианты продублированы CHECK-ограничениями в миграции *_savings.
  amount     Int
  /// Есть у INCOME/EXPENSE, null у SAVING/SAVING_ADJUSTMENT
  categoryId Int?
  category   Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// День операции без времени — группировки не зависят от часового пояса
  date       DateTime        @db.Date
  comment    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId, date])
  @@index([userId, categoryId, date])
}

/// Отложенная покупка: «подумать ещё раз» в день remindOn
model PurchaseReminder {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  /// День напоминания без времени, как Transaction.date
  remindOn  DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([userId, remindOn])
}
