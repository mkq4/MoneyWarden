generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  /// Логин для входа по паролю (хранится в нижнем регистре).
  /// null — пользователь пришёл только через OAuth
  username      String?        @unique
  /// null — OAuth-провайдер (например, VK) не отдал email
  email         String?        @unique
  name          String?
  /// null — пользователь зарегистрирован только через OAuth
  passwordHash  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accounts      Account[]
  refreshTokens RefreshToken[]
}

enum AuthProvider {
  GOOGLE
  VK
}

/// Привязка внешнего OAuth-аккаунта к пользователю
model Account {
  id                Int          @id @default(autoincrement())
  provider          AuthProvider
  providerAccountId String
  userId            Int
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Refresh-токены хранятся только в виде sha256-хеша
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
